# Copy this file to .env and fill in your values. Never commit .env.

# PayPal sandbox app credentials (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=SANDBOX

# AI provider key (keep the one you use)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# App
PORT=3000
