# Copy this file to .env and fill in your values. Never commit .env.
# With no PayPal or AI keys, ProofPay runs in mock mode (everything simulated).

# PayPal sandbox app (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# mock | sandbox | live (default: sandbox when keys are set, otherwise mock)
PAYPAL_MODE=

# AI provider: set ONE key. AI_PROVIDER can force anthropic | openai | google | meta | mock.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Google Gemini (aistudio.google.com > Get API key)
GEMINI_API_KEY=
# Meta Muse Spark (Meta Model API, dev.meta.ai)
META_API_KEY=
AI_PROVIDER=
# Optional model overrides
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_MODEL=gpt-4.1-mini
GEMINI_MODEL=gemini-3.8-flash
META_MODEL=muse-spark-1.3

# App
PORT=3000
BASE_URL=http://localhost:3000
DEFAULT_CURRENCY=SGD
# Client objection window before automatic release (seconds). 172800 = 48h. Use 60 for demos.
OBJECTION_WINDOW_SECONDS=172800
